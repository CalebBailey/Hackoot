# Pusher Channels - required for real-time multiplayer
# Create a free account at https://pusher.com and create a new Channels app

# Server-side (never exposed to browser)
PUSHER_APP_ID=your_app_id
PUSHER_KEY=your_key
PUSHER_SECRET=your_secret
PUSHER_CLUSTER=eu

# Client-side (safe to expose - NEXT_PUBLIC_ prefix required)
NEXT_PUBLIC_PUSHER_KEY=your_key
NEXT_PUBLIC_PUSHER_CLUSTER=eu

# Giphy - required for GIF search in the question editor
# Create a free account and API key at https://developers.giphy.com/dashboard/
# Note: free (beta) keys are limited to 100 API calls per hour.
# The key is only used server-side during quiz creation; players load GIFs
# directly from Giphy's CDN during gameplay and do not count against this limit.
GIPHY_API_KEY=your_giphy_api_key


